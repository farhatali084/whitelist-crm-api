APP_NAME=WhitelistCRM
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite file: database/database.sqlite (created by `composer start`)
DB_CONNECTION=sqlite

# The API is stateless: no sessions, cache or queues are used.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Business rules (defaults shown; all optional)
CRM_TIMEZONE=Asia/Almaty
CRM_WORKDAY_START=09:00
CRM_WORKDAY_END=18:00
CRM_MEETING_MINUTES=60
